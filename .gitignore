# 归档的试验失败品（体积大，不进仓库）
archive/

# 敏感文件
android-lite/keystore/*.jks
android-lite/keystore/CREDENTIALS.txt
**/signing.properties

# 构建产物
android-lite/build/
android-lite/**/build/
android-lite/local.properties

# 生成的 WebView 资源（KaTeX 由 src/vendor/katex 在构建时复制）
android-lite/app/src/main/assets/

# 本地数据
save/
apk/

# 校验脚本工作区（可复用的临时产物，不进仓库）
tools/.work/

# 本地代码索引（CodeGraph）
.codegraph/

# Kotlin 编译缓存
.kotlin/

# 端侧 TTS 原生库（体积大，可由 tools/build-cosyvoice-android.ps1 重建）
android-lite/engine/cosyvoice/src/main/jniLibs/**/*.so
